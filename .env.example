# Set true with test keys to enable sandbox checkout (no database required).
PAYMENTS_ENABLED=false
PAYMENT_MODE=test
# Live checkout requires your approved Asal inventory.
CATALOGUE_APPROVED=false
# Set true only after shipping, tax and the final payable total are configured.
PURCHASE_TOTAL_APPROVED=false
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
# Only KEY_ID may have a public prefix. Checkout uses the runtime API key_id
# response so a stale build-time public key cannot override the server key.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me
# Required for live checkout, optional/unused for sandbox checkout:
RAZORPAY_WEBHOOK_SECRET=
# Cloudflare production uses D1 via ASAL_DB. PostgreSQL remains optional elsewhere.
ORDER_STORAGE=d1
DATABASE_URL=

# Owner login. Configure using scripts/set-owner-password.mjs (stdin password).
# Store only in runtime Worker secrets, never public/build-time environment.
ADMIN_LOGIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Optional alternative: Cloudflare Access when password login is not configured.
ADMIN_ACCESS_TEAM_DOMAIN=
ADMIN_ACCESS_AUD=
# Comma-separated exact owner email allowlist; no public registration.
ADMIN_EMAILS=

# Seller email delivery; use an owned, verified sender domain in Resend.
SELLER_ORDER_EMAIL=
SELLER_ORDER_FROM_EMAIL=
RESEND_API_KEY=
# Random secret of at least 32 characters, used by the 5-minute Worker cron.
NOTIFICATION_CRON_SECRET=

# Optional public Search Console HTML verification token (available at build time).
# Prefer DNS verification for the Domain property; never put Google credentials here.
GOOGLE_SITE_VERIFICATION=
