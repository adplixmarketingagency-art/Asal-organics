# Payments are disabled until this is explicitly set to true and every server value exists.
PAYMENTS_ENABLED=false
PAYMENT_MODE=test
# Do not enable payments until the catalogue is your approved Asal inventory.
CATALOGUE_APPROVED=false
# Set true only after shipping, tax and the final payable total are configured.
PURCHASE_TOTAL_APPROVED=false
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Seller notification delivery (planned outbox worker; never expose these to the browser).
SELLER_ORDER_EMAIL=
RESEND_API_KEY=
